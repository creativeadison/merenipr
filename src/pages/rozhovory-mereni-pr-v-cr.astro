---
import Base from '../layouts/Base.astro';
import { nactiRozhovory } from '../lib/utils';
import { autorka, links } from '../data/site';

const rozhovory = await nactiRozhovory();
---
<Base
  title="Rozhovory Měření PR v ČR"
  description="Jak o měření PR přemýšlejí přední čeští komunikační manažeři, ředitelé agentur a CEOs? Jejich zkušenosti z praxe, bez příkras."
>
  <header class="hlavicka-stranky">
    <div class="container obal">
      <div>
        <span class="eyebrow">Rozhovory</span>
        <h1>Jak se měří PR v ČR?</h1>
        <p class="perex">Zahraničních případových studií a metodických příruček je dost. Chybí ale něco jiného — přímý pohled na to, jak o měření PR přemýšlejí lidé, kteří ho každý den dělají v českém prostředí. Co funguje v globální korporaci, nemusí sedět agentuře se třemi klienty.</p>
        <p>Proto se ptáme. Komunikačních manažerů, ředitelů agentur, CEOs i lidí, kteří o PR rozhodují na straně zadavatelů. Jak definují úspěch? Co měří a co měřit neumějí? Kde naráží na limity a co jim skutečně pomáhá? Tady jsou jejich odpovědi.</p>
      </div>
      <aside class="autorka">
        <img src={autorka.foto} alt="" width="72" height="72" />
        <p>Rozhovory připravila <a href={links.linkedin} target="_blank" rel="noopener">{autorka.jmeno}</a>, CEO agentury <a href={links.adison} target="_blank" rel="noopener">Adison</a>. Alžběta dlouhodobě bojuje proti nesmyslným PR metrikám a pomáhá firmám posunout komunikaci od dojmů k hmatatelným výsledkům.</p>
      </aside>
    </div>
  </header>

  <section class="sekce">
    <div class="container seznam">
      {rozhovory.map((r) => (
        <article class="rozhovor">
          <a href={`/${r.id}`} class="foto" tabindex="-1" aria-hidden="true">
            <img src={r.data.foto} alt="" loading="lazy" width="800" height="533" />
          </a>
          <div class="text">
            <p class="kdo"><strong>{r.data.jmeno}</strong>{r.data.pozice}, {r.data.firma}</p>
            <h2><a href={`/${r.id}`}>{r.data.title}</a></h2>
            {r.data.citat && <p class="citat">„{r.data.citat}“</p>}
            <a href={`/${r.id}`} class="odkaz-sipka">Přečíst rozhovor</a>
          </div>
        </article>
      ))}
      <div class="dalsi">
        <p><strong>Další rozhovory připravujeme.</strong> Přihlaste se k odběru novinek a nenechte si je ujít.</p>
        <a href="#newsletter" class="btn btn-outline">Odebírat novinky</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hlavicka-stranky { background: var(--pozadi-jemne); padding: clamp(48px, 7vw, 88px) 0; border-bottom: 1px solid var(--linka); }
  .obal { display: grid; grid-template-columns: 1.6fr 1fr; gap: 56px; align-items: end; }
  .perex { font-size: 1.15rem; color: var(--fialova-tmava); font-weight: 500; }
  .obal p { color: var(--text-jemny); }
  .autorka { background: #fff; border-radius: var(--radius); padding: 24px; border: 1px solid var(--linka); }
  .autorka img { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; object-position: top; margin-bottom: 14px; }
  .autorka p { font-size: .92rem; margin: 0; }

  .seznam { display: grid; gap: 32px; }
  .rozhovor { display: grid; grid-template-columns: 1fr 1.2fr; gap: 48px; align-items: center; }
  .foto img { border-radius: var(--radius-velky); aspect-ratio: 3 / 2; object-fit: cover; transition: transform .3s; }
  .foto { overflow: hidden; border-radius: var(--radius-velky); }
  .foto:hover img { transform: scale(1.03); }
  .kdo { color: var(--text-jemny); font-size: .95rem; }
  .kdo strong { display: block; color: var(--magenta-dark); font-size: 1rem; }
  .rozhovor h2 { font-size: clamp(1.35rem, 2.4vw, 1.9rem); }
  .rozhovor h2 a { color: inherit; text-decoration: none; }
  .rozhovor h2 a:hover { color: var(--magenta); }
  .citat { font-size: 1.1rem; font-style: italic; color: var(--fialova); border-left: 3px solid var(--magenta); padding-left: 16px; }
  .dalsi { margin-top: 24px; padding: 28px 32px; border-radius: var(--radius); border: 2px dashed var(--linka); display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
  .dalsi p { margin: 0; color: var(--text-jemny); }
  .dalsi strong { color: var(--fialova-tmava); }

  @media (max-width: 820px) {
    .obal, .rozhovor { grid-template-columns: 1fr; gap: 28px; }
  }
</style>
