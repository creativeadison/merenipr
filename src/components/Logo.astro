---
const { svetle = false } = Astro.props;
---
<a href="/" class:list={['logo', { svetle }]} aria-label="Měření PR – úvodní stránka">
  <span class="znak" aria-hidden="true">
    <svg viewBox="0 0 32 32" width="32" height="32">
      <rect x="3" y="18" width="6" height="10" rx="2" fill="#e83792" />
      <rect x="13" y="11" width="6" height="17" rx="2" fill="#a0379a" />
      <rect x="23" y="4" width="6" height="24" rx="2" fill="#523792" />
    </svg>
  </span>
  <span class="text">Měření<strong>PR</strong></span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--fialova-tmava); }
  .znak { display: grid; place-items: center; }
  .text { font-weight: 600; font-size: 1.18rem; letter-spacing: -0.02em; }
  .text strong { font-weight: 800; color: var(--magenta); margin-left: 3px; }
  .svetle { color: #fff; }
  .svetle rect:last-child { fill: #fff; }
  .logo:hover { color: inherit; }
</style>
